{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["airflow:PublishMetrics"],
      "Resource": "arn:aws:airflow:us-east-1:172542676092:environment/etl-monitoring-mwaa"
    },
    {
      "Effect": "Allow",
      "Action": ["s3:ListAllMyBuckets"],
      "Resource": "*"
    },
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject*","s3:GetBucket*","s3:List*"],
      "Resource": [
        "arn:aws:s3:::mwaa-etl-monitoring-172542676092",
        "arn:aws:s3:::mwaa-etl-monitoring-172542676092/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": ["logs:CreateLogStream","logs:CreateLogGroup","logs:PutLogEvents","logs:GetLogEvents","logs:GetLogRecord","logs:GetLogGroupFields","logs:GetQueryResults","logs:DescribeLogGroups"],
      "Resource": "arn:aws:logs:us-east-1:172542676092:log-group:airflow-etl-monitoring-mwaa-*"
    },
    {
      "Effect": "Allow",
      "Action": ["logs:DescribeLogGroups"],
      "Resource": "*"
    },
    {
      "Effect": "Allow",
      "Action": ["cloudwatch:PutMetricData"],
      "Resource": "*"
    },
    {
      "Effect": "Allow",
      "Action": ["sqs:ChangeMessageVisibility","sqs:DeleteMessage","sqs:GetQueueAttributes","sqs:GetQueueUrl","sqs:ReceiveMessage","sqs:SendMessage"],
      "Resource": "arn:aws:sqs:us-east-1:*:airflow-celery-*"
    },
    {
      "Effect": "Allow",
      "Action": ["kms:Decrypt","kms:DescribeKey","kms:GenerateDataKey*","kms:Encrypt"],
      "NotResource": "arn:aws:kms:*:172542676092:key/*",
      "Condition": {
        "StringLike": {"kms:ViaService": ["sqs.us-east-1.amazonaws.com"]}
      }
    },
    {
      "Effect": "Allow",
      "Action": ["es:ESHttpPost"],
      "Resource": "arn:aws:es:us-east-1:172542676092:domain/etl-monitoring/etl-logs-*"
    },
    {
      "Effect": "Allow",
      "Action": ["secretsmanager:GetSecretValue"],
      "Resource": "arn:aws:secretsmanager:us-east-1:172542676092:secret:etl/opensearch/*"
    },
    {
      "Effect": "Allow",
      "Action": ["sns:Publish"],
      "Resource": "arn:aws:sns:us-east-1:172542676092:etl-failures"
    }
  ]
}
